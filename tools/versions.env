#
# The dev tool versions CI runs, in one place (#647). reusable-python-ci.yml
# and reusable-go-ci.yml read this file (from the checkout here, from main for
# a caller), and tools/doctor/doctor.sh (`make doctor`) compares a machine's
# tools with it. Go itself is the repository's go.mod `toolchain` line (else
# `go`), as reusable-go-ci.yml reads it. One KEY=VALUE per line, nothing else:
# the workflows refuse any other line.
RUFF_VERSION=0.17.1
COVERAGE_VERSION=7.16.2
STATICCHECK_VERSION=2026.2.2
GOVULNCHECK_VERSION=v1.9.0
GOCOVER_COBERTURA_VERSION=v1.5.0
